Meta.AppIsMultiIPAware=True
App.DisplayName=ARK: Survival Ascended (Cluster)
App.RootDir=./arkasacluster/
App.BaseDirectory=./arkasacluster/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin={{PythonExecutable}}
App.ExecutableLinux=
App.WorkingDir=supervisor
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=-u arkclustersupervisor.py {{MapIsland}}{{MapScorched}}{{MapCenter}}{{MapAberration}}{{MapExtinction}}{{MapAstraeos}}{{MapRagnarok}}{{MapValguero}}{{MapLostColony}}{{MapGenesis}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"SteamAppId":"2399830","ARK_GAME":"asa","ARK_BASE_DIR":"{{$FullBaseDir}}","ARK_SESSION_NAME":"{{SessionName}}","ARK_CLUSTER_ID":"{{ClusterId}}","ARK_RCON_PASSWORD":"{{RconPassword}}","ARK_SERVER_PASSWORD":"{{ServerPassword}}","ARK_MAX_PLAYERS":"{{MaxPlayersPerMap}}","ARK_START_DELAY":"{{StartDelay}}","ARK_START_BATCH":"{{StartBatch}}","ARK_RESTART_WARNING":"{{RestartWarning}}","ARK_READY_TIMEOUT":"{{ReadyTimeout}}","ARK_SAVE_TIMEOUT":"{{SaveTimeout}}","ARK_EXIT_TIMEOUT":"900","ARK_HIVE_CLEANUP":"{{HiveCleanup}}","ARK_CPU_PINNING":"{{CpuPinning}}","ARK_AUTO_RESTART":"{{AutoRestart}}","ARK_CROSS_CHAT":"{{CrossChat}}","ARK_DISCORD_TOKEN":"{{DiscordToken}}","ARK_DISCORD_CHANNEL":"{{DiscordChannel}}","ARK_DISCORD_TO_GAME":"{{DiscordToGame}}","ARK_RATE_PRESET":"{{RatePreset}}","ARK_EVENT":"{{Event}}","ARK_CUSTOM_OPTIONS":"{{CustomOptions}}","ARK_MODS":"{{Mods}}","ARK_CUSTOM_ARGS":"{{CustomArgs}}","ARK_GAMEINI_EXTRA":"{{GameIniExtra}}","ARK_GUS_EXTRA":"{{GusExtra}}","ARK_GAME_PORT":"{{$GamePort}}","ARK_QUERY_PORT":"{{$QueryPort}}","ARK_RCON_PORT":"{{$RCONPort}}","ARK_BIND_IP":"{{$ApplicationIPBinding}}"}
App.CommandLineParameterFormat={0}={1}
App.CommandLineParameterDelimiter= 
App.ExitMethod=String
App.ExitTimeout=900
App.ExitString=DoExit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[arkasaclusterports.json]
App.AdminPortRef=RCONPort
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=GamePort
App.UniversalSleepSteamQueryPortRef=
App.MaxUsers=700
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[arkasaclusterupdates.json]
App.PreStartStages=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeSupported=True
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua","*.ark","*.arkprofile","*.arktribe","*.arktributetribe","*.profilebak","*.tribebak"]
App.QuiesceCommand=quiesce
App.DequiesceCommand=dequiesce
App.QuiesceSettleDelayMilliseconds=2000
App.MonitorChildProcess=False
App.DumpFullChildProcessTree=False
App.MonitorChildProcessWaitMs=100
App.MonitorChildProcessName=
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=Immediate
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^\[[^\]]+\] (Keep Alive|\[S_API FAIL\] SteamAPI_Init\(\) failed; SteamAPI_IsSteamRunning\(\) failed\.|Server received, But no response!!|Setting breakpad minidump AppID = \d+)\s*$
Console.AppReadyRegex=^$
Console.UserJoinRegex=^\[[^\]]+\] >>> (?<username>.+?) \((?<userid>[0-9A-Za-z]+)\) joined this ARK!$
Console.UserLeaveRegex=^\[[^\]]+\] <<< (?<username>.+?) \((?<userid>[0-9A-Za-z]+)\) left this ARK!$
Console.UserChatRegex=^\[[^\]]+\] <(?!<<)(?<username>.+?)> (?<message>.+)$
Console.UpdateAvailableRegex=
Console.MetricsRegex=^\[supervisor\] METRICS maps_up=(?<Maps>\d+) players=\d+ ram_gb=(?<GB>[\d.]+) cpu_cores=[\d.]+$
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.HideFromConsoleRegex=^\[.+?\] VERBOSE
Console.UserActions={"Kick": "kick {{userid}}", "Ban": "ban {{userid}}", "Whereis": "whereis {{userid}}"}
Limits.SleepMode=True
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
