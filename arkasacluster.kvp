Meta.EndpointURIFormat=
Meta.ConfigManifest=arkasaclusterconfig.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=arkasacluster.kvp
Meta.MinAMPVersion=2.8.0.0
Meta.SpecificDockerImage=
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=NotSupported
Meta.ContainerPolicyReason=ASA server existuje jen pro Windows.
Meta.ExtraSetupStepsURI=
